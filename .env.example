# claude | grok | openai. PDF conversion and extraction both use Claude
# unless LLM_PROVIDER is set to something else.
LLM_PROVIDER=claude

# Same Keychain account for both steps: service autoschemakg, account ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-sonnet-4-5

# Used when LLM_PROVIDER=grok.
# XAI_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4

# Used when LLM_PROVIDER=openai.
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
