# grok | claude | openai
LLM_PROVIDER=grok

# Used when LLM_PROVIDER=grok. Override LLM_MODEL if you want a smaller model.
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4

